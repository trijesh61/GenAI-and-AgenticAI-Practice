    "\n",
    "llm = LLM(\n",
    "    model=os.getenv(\"TOKENHARBOR_MODEL\"),\n",
    "    api_key=os.getenv(\"TOKENHARBOR_API_KEY\"),\n",
    "    base_url=os.getenv(\"TOKENHARBOR_BASE_URL\"),\n",
    "    custom_openai=True,\n",
    "    temperature=0.7,\n",
    ")"
   ]
